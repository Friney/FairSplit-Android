<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/nav_graph"
        app:startDestination="@id/mainFragment">

    <fragment
            android:id="@+id/loginFragment"
            android:name="com.friney.fairsplit.ui.auth.LoginFragment"
            android:label="fragment_login"
            tools:layout="@layout/fragment_login" />

    <fragment
            android:id="@+id/registerFragment"
            android:name="com.friney.fairsplit.ui.auth.RegisterFragment"
            android:label="fragment_register"
            tools:layout="@layout/fragment_register" />

    <fragment
            android:id="@+id/mainFragment"
            android:name="com.friney.fairsplit.ui.main.MainFragment"
            android:label="fragment_main"
            tools:layout="@layout/fragment_main">
        <action
                android:id="@+id/action_mainFragment_to_detailsEventFragment"
                app:destination="@id/detailsEventFragment" />
        <action
                android:id="@+id/action_mainFragment_to_createEventFragment"
                app:destination="@id/createEventFragment" />
    </fragment>
    <fragment
            android:id="@+id/settingsFragment"
            android:name="com.friney.fairsplit.ui.settings.SettingsFragment"
            android:label="fragment_settings"
            tools:layout="@layout/fragment_settings" />
    <fragment
            android:id="@+id/detailsEventFragment"
            android:name="com.friney.fairsplit.ui.details.event.DetailsEventFragment"
            android:label="fragment_details_event"
            tools:layout="@layout/fragment_details_event">
        <argument
                android:name="event"
                app:argType="com.friney.fairsplit.network.model.event.Event" />
        <action
                android:id="@+id/action_detailsEventFragment_to_detailsReceiptFragment"
                app:destination="@id/detailsReceiptFragment" />
        <action
                android:id="@+id/action_detailsEventFragment_to_createReceiptFragment"
                app:destination="@id/createReceiptFragment" />
    </fragment>
    <fragment
            android:id="@+id/detailsReceiptFragment"
            android:name="com.friney.fairsplit.ui.details.receipt.DetailsReceiptFragment"
            android:label="fragment_details_receipt"
            tools:layout="@layout/fragment_details_receipt">
        <argument
                android:name="receipt"
                app:argType="com.friney.fairsplit.network.model.receipt.Receipt" />
        <action
                android:id="@+id/action_detailsReceiptFragment_to_detailsExpenseFragment"
                app:destination="@id/detailsExpenseFragment" />
        <action
                android:id="@+id/action_detailsReceiptFragment_to_createExpenseFragment"
                app:destination="@id/createExpenseFragment" />
        <argument
                android:name="eventId"
                app:argType="long" />
    </fragment>
    <fragment
            android:id="@+id/detailsExpenseFragment"
            android:name="com.friney.fairsplit.ui.details.expense.DetailsExpenseFragment"
            android:label="fragment_details_expense"
            tools:layout="@layout/fragment_details_expense">
        <argument
                android:name="expense"
                app:argType="com.friney.fairsplit.network.model.expense.Expense" />
        <argument
                android:name="receiptId"
                app:argType="long" />
    </fragment>
    <fragment
            android:id="@+id/createEventFragment"
            android:name="com.friney.fairsplit.ui.create.event.CreateEventFragment"
            android:label="fragment_create_event"
            tools:layout="@layout/fragment_create_event" />
    <fragment
            android:id="@+id/createExpenseFragment"
            android:name="com.friney.fairsplit.ui.create.expense.CreateExpenseFragment"
            android:label="fragment_create_expense"
            tools:layout="@layout/fragment_create_expense">
        <argument
                android:name="receiptId"
                app:argType="long" />
    </fragment>
    <fragment
            android:id="@+id/createReceiptFragment"
            android:name="com.friney.fairsplit.ui.create.receipt.CreateReceiptFragment"
            android:label="fragment_create_receipt"
            tools:layout="@layout/fragment_create_receipt">
        <argument
                android:name="eventId"
                app:argType="long" />
    </fragment>
</navigation>